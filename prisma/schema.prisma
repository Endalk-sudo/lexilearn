// LexiLearn — Local English Learning Web App
// Single-user, 100% local, SQLite-backed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Pre-built or custom word lists (TOEFL, IELTS, GRE, Common 5000, user decks…)
model Deck {
  id          String   @id @default(cuid())
  name        String
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  words       Word[]
}

// Dictionary entry
model Word {
  id         String   @id @default(cuid())
  word       String
  pos        String?  // part of speech (noun, verb, adj…)
  ipa        String?  // IPA transcription
  syllables  String?  // JSON array of syllables
  cefr       String?  // A1..C2
  definitions String? // JSON array of {pos, text}
  examples   String?  // JSON array of strings
  synonyms   String?  // JSON array
  antonyms   String?  // JSON array
  etymology  String?
  amharic    String?  // Amharic (አማርኛ) translation / definition
  deckId     String
  deck       Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  srsCard    SrsCard?
  createdAt  DateTime @default(now())

  @@index([deckId])
  @@index([word])
}

// Per-word SRS progress (single user, so no userId)
model SrsCard {
  wordId          String   @id
  word            Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  easeFactor      Float    @default(2.5)
  interval        Int      @default(0)
  repetitions     Int      @default(0)
  nextReview      DateTime @default(now())
  lastReviewed    DateTime?
  status          String   @default("new") // new | learning | reviewing | mastered
  totalReviews    Int      @default(0)
  correctReviews  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([nextReview])
  @@index([status])
}

// Per-review log for analytics
model ReviewLog {
  id         Int      @id @default(autoincrement())
  wordId     String
  word       String
  deckId     String?
  grade      Int      // 0=Again, 3=Hard, 4=Good, 5=Easy
  mode       String   // review | learn | quiz
  isCorrect  Boolean
  reviewedAt DateTime @default(now())

  @@index([reviewedAt])
  @@index([wordId])
}

// Quiz session log
model QuizSession {
  id           String   @id @default(cuid())
  mode         String   // mc | reverse_mc | typing | spelling_bee | speed_round
  total        Int
  correct      Int
  xpEarned     Int      @default(0)
  startedAt    DateTime @default(now())
  completedAt  DateTime?
}

// Key-value store for app metadata (streak, totalXp, lastSessionDate, settings…)
model AppStat {
  key   String @id
  value String
}

// AI Mentor session history (local Ollama)
model MentorSession {
  id          String   @id @default(cuid())
  mode        String   // practice | writing | conversation | explain | reading
  title       String?
  prompt      String?
  response    String?
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([mode])
  @@index([createdAt])
}

// Personal error / weakness log
model ErrorLog {
  id          String   @id @default(cuid())
  type        String   // grammar | collocation | spelling | word_choice | other
  original    String
  corrected   String?
  explanation String?
  wordId      String?
  source      String?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([resolved])
  @@index([createdAt])
}

// Generated practice materials
model PracticeMaterial {
  id          String   @id @default(cuid())
  type        String
  title       String?
  content     String
  wordIds     String?
  deckId      String?
  difficulty  String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// Branching AI Mentor domain model
model MentorProject {
  id          String         @id @default(cuid())
  name        String
  goal        String?
  createdAt   DateTime       @default(now())
  branches    MentorBranch[]
}

model MentorBranch {
  id                String         @id @default(cuid())
  projectId         String
  parentBranchId    String?
  parentNodeId      String?
  title             String
  focusTag          String
  mode              String
  difficultyCeiling Int            @default(3)
  locked            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  project           MentorProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes             MentorNode[]
  attempts          MentorAttempt[]
  childBranches     MentorBranch[] @relation("MentorBranchTree")
  parentBranch      MentorBranch?  @relation("MentorBranchTree", fields: [parentBranchId], references: [id])

  @@index([projectId])
  @@index([parentBranchId])
}

model MentorNode {
  id               String          @id @default(cuid())
  branchId         String
  parentNodeId     String?
  kind             String          @default("question")
  prompt           String
  expectedPatterns String
  hints            String
  targetTags       String
  difficulty       Int             @default(1)
  createdAt        DateTime        @default(now())
  branch           MentorBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  attempts         MentorAttempt[]

  @@index([branchId])
  @@index([parentNodeId])
}

model MentorAttempt {
  id           String          @id @default(cuid())
  nodeId       String
  branchId     String
  answer       String
  confidence   Int?
  timeMs       Int?
  keystrokes   Int?
  hintLevel    Int             @default(0)
  selfCorrect  String?
  createdAt    DateTime        @default(now())
  node         MentorNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  branch       MentorBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  feedback     MentorFeedback?

  @@index([nodeId])
  @@index([branchId])
  @@index([createdAt])
}

model MentorFeedback {
  id            String        @id @default(cuid())
  attemptId     String        @unique
  scores        String
  corrections  String
  explanation   String
  nativeVersion String
  followUp      String
  diff          String
  masteryDelta  String
  diagnosis     String?
  rawJson       String?
  attempt       MentorAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model MentorErrorCard {
  id          String   @id @default(cuid())
  tag         String
  errorType   String
  wrong       String
  right       String
  context     String
  ease        Float    @default(2.5)
  intervalDays Int     @default(1)
  dueAt       DateTime @default(now())
  lapses      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dueAt])
  @@index([tag])
}

model MentorSkillMastery {
  tag         String   @id
  mastery     Float    @default(0.5)
  attempts    Int      @default(0)
  correct     Int      @default(0)
  lastSeen    DateTime?
  nextReview  DateTime?
}

model MentorProfile {
  id          Int      @id @default(1)
  goals       String?
  preferences String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MentorTurn {
  id        String   @id @default(cuid())
  branchId  String
  nodeId    String?
  role      String
  content   String
  meta      String?
  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([createdAt])
}

model MentorKnowledge {
  id          String   @id @default(cuid())
  title       String
  tag         String
  content     String
  embedding   String?
  source      String?
  createdAt   DateTime @default(now())

  @@index([tag])
}


model MentorWeeklyReport {
  id           String   @id @default(cuid())
  weekKey      String   @unique
  summary      String
  strengths    String
  weaknesses   String
  topErrors    String
  confidence   String
  nextFocus    String
  actionPlan   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PronunciationAttempt {
  id              String   @id @default(cuid())
  target          String
  transcript      String
  accuracy        Float
  missingWords    String
  extraWords      String
  feedback        String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model NaturalnessAttempt {
  id          String   @id @default(cuid())
  input       String
  score       Float
  verdict     String
  native      String
  alternatives String
  explanation String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
