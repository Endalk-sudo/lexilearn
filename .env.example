DATABASE_URL=file:./db/custom.db
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe

# Local speech (speaches: faster-whisper STT + Kokoro/Piper TTS)
SPEECH_BASE_URL=http://127.0.0.1:8000
SPEECH_STT_MODEL=Systran/faster-whisper-base.en
SPEECH_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEECH_TTS_VOICE=af_heart

# AI Mentor Provider Configuration (auto | openrouter | gemini | ollama)
# AI_PROVIDER=auto

# OpenRouter (Access Claude, GPT-4o, Llama 3, DeepSeek, etc.)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini (Direct API access to Gemini 2.5 Flash / 1.5 Pro)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
